//@HLQ@S JOB (1),'MIG SETUP',CLASS=@CLASS@,MSGCLASS=@MSGCLASS@,
//         MSGLEVEL=(1,1),USER=@HLQ@,PASSWORD=@PASSWORD@
//*-------------------------------------------------------------------
//* SETUP - run once (re-running it RESETS the audit history).
//* Creates: GDG bases APPROVED/REJECTED + their model DSCB,
//*          VSAM KSDS MIG.AUDIT.KSDS (batch log, key = batch id),
//*          VSAM KSDS MIG.EXCLOG.KSDS (exception log),
//*          load library MIG.LOAD.
//* Everything is under @HLQ@.MIG.* on volume @VOL@.
//*-------------------------------------------------------------------
//DELETE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DELETE @HLQ@.MIG.AUDIT.KSDS CLUSTER PURGE
 DELETE @HLQ@.MIG.EXCLOG.KSDS CLUSTER PURGE
 DELETE @HLQ@.MIG.GATE.APPROVED GDG FORCE
 DELETE @HLQ@.MIG.GATE.REJECTED GDG FORCE
 DELETE @HLQ@.MIG.GDGMODEL NONVSAM
 DELETE @HLQ@.MIG.LOAD NONVSAM
 SET MAXCC = 0
/*
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE GDG (NAME(@HLQ@.MIG.GATE.APPROVED) LIMIT(10) SCRATCH NOEMPTY)
 DEFINE GDG (NAME(@HLQ@.MIG.GATE.REJECTED) LIMIT(10) SCRATCH NOEMPTY)
 DEFINE CLUSTER (NAME(@HLQ@.MIG.AUDIT.KSDS) -
        VOLUMES(@VOL@) TRACKS(5 5) -
        INDEXED UNIQUE KEYS(15 0) RECORDSIZE(120 120) -
        FREESPACE(10 10) SHAREOPTIONS(2 3))
 DEFINE CLUSTER (NAME(@HLQ@.MIG.EXCLOG.KSDS) -
        VOLUMES(@VOL@) TRACKS(30 15) -
        INDEXED UNIQUE KEYS(20 0) RECORDSIZE(120 120) -
        FREESPACE(10 10) SHAREOPTIONS(2 3))
/*
//ALLOC    EXEC PGM=IEFBR14
//MODEL    DD DSN=@HLQ@.MIG.GDGMODEL,DISP=(NEW,CATLG),UNIT=@UNIT@,
//            VOL=SER=@VOL@,SPACE=(TRK,0),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800,DSORG=PS)
//LOADLIB  DD DSN=@HLQ@.MIG.LOAD,DISP=(NEW,CATLG,DELETE),UNIT=@UNIT@,
//            SPACE=(TRK,(10,5,10)),DCB=(RECFM=U,BLKSIZE=6144)
//
