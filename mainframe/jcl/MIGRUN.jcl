//@HLQ@V JOB (1),'MIGRUN',CLASS=@CLASS@,MSGCLASS=@MSGCLASS@,
//         MSGLEVEL=(1,1),USER=@HLQ@,PASSWORD=@PASSWORD@
//*-------------------------------------------------------------------
//* MIGRUN - Legacy-to-Modern Data Migration Validator (TK5 version)
//*  CLEAN    IDCAMS   delete the work datasets of the previous run
//*  LOADSRC  IEBGENER legacy extract (inline cards) -> SRC.EXTRACT
//*  LOADTGT  IEBGENER modern extract (inline cards) -> TGT.EXTRACT
//*  SORTSRC  SORT     source by key (+whole record: deterministic)
//*  SORTTGT  SORT     target by key
//*  DEFKSDS  IDCAMS   define the target VSAM KSDS (replaces DB2)
//*  LOADKSDS IDCAMS   REPRO target into KSDS (duplicate keys are
//*                    rejected by VSAM -> RC 8, caught by REXX)
//*  UNLOAD   IDCAMS   REPRO KSDS -> TGT.UNLOAD (key order)
//*  MATCH    COBOL    dedupe + match-merge -> exceptions + control
//*  REXXRUN  BREXX    cross-check counts, decide RC 0/4/8/12
//*  AUDIT    IDCAMS   REPRO audit records into the two log KSDS
//*  APPROVE  IEBGENER RC 0/4  -> GATE.APPROVED(+1)  (COND gate)
//*  REJECT   IEBGENER RC 8+   -> GATE.REJECTED(+1)
//*  PRINTRPT/PRINTOUT print report + result to SYSOUT
//*-------------------------------------------------------------------
//CLEAN    EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DELETE @HLQ@.MIG.SRC.EXTRACT NONVSAM
 DELETE @HLQ@.MIG.SRC.SORTED NONVSAM
 DELETE @HLQ@.MIG.SRC.DEDUP NONVSAM
 DELETE @HLQ@.MIG.TGT.EXTRACT NONVSAM
 DELETE @HLQ@.MIG.TGT.SORTED NONVSAM
 DELETE @HLQ@.MIG.TGT.UNLOAD NONVSAM
 DELETE @HLQ@.MIG.TGT.KSDS CLUSTER PURGE
 DELETE @HLQ@.MIG.RECON.EXCEPT NONVSAM
 DELETE @HLQ@.MIG.RECON.EXCSORT NONVSAM
 DELETE @HLQ@.MIG.RECON.REPORT NONVSAM
 DELETE @HLQ@.MIG.RECON.MIGOUT NONVSAM
 DELETE @HLQ@.MIG.RECON.AUDREC NONVSAM
 DELETE @HLQ@.MIG.RECON.EXCREC NONVSAM
 DELETE @HLQ@.MIG.CTRL.OUT NONVSAM
 SET MAXCC = 0
/*
//*------------------ load the two extracts (80-column cards) -------
//LOADSRC  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@HLQ@.MIG.SRC.EXTRACT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSUT1   DD DATA,DLM=$$
@DATA:SRC@
$$
//LOADTGT  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=@HLQ@.MIG.TGT.EXTRACT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSUT1   DD DATA,DLM=$$
@DATA:TGT@
$$
//*------------------ ASSIGNMENT 1 : SORT ----------------------------
//SORTSRC  EXEC SORT
//SORTIN   DD DSN=@HLQ@.MIG.SRC.EXTRACT,DISP=SHR
//SORTOUT  DD DSN=@HLQ@.MIG.SRC.SORTED,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD *
 SORT FIELDS=(1,80,CH,A)
/*
//SORTTGT  EXEC SORT
//SORTIN   DD DSN=@HLQ@.MIG.TGT.EXTRACT,DISP=SHR
//SORTOUT  DD DSN=@HLQ@.MIG.TGT.SORTED,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD *
 SORT FIELDS=(1,80,CH,A)
/*
//*------------------ VSAM: the target table ------------------------
//DEFKSDS  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(@HLQ@.MIG.TGT.KSDS) -
        VOLUMES(@VOL@) TRACKS(30 15) -
        INDEXED UNIQUE KEYS(18 0) RECORDSIZE(80 80) -
        FREESPACE(10 10) SHAREOPTIONS(2 3))
/*
//LOADKSDS EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//IN       DD DSN=@HLQ@.MIG.TGT.SORTED,DISP=SHR
//OUT      DD DSN=@HLQ@.MIG.TGT.KSDS,DISP=OLD
//SYSIN    DD *
 REPRO INFILE(IN) OUTFILE(OUT)
/*
//UNLOAD   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//IN       DD DSN=@HLQ@.MIG.TGT.KSDS,DISP=SHR
//OUT      DD DSN=@HLQ@.MIG.TGT.UNLOAD,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SYSIN    DD *
 REPRO INFILE(IN) OUTFILE(OUT)
/*
//*------------------ ASSIGNMENT 2 : COBOL --------------------------
//MATCH    EXEC PGM=MIGMATCH
//STEPLIB  DD DSN=@HLQ@.MIG.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//SRCIN    DD DSN=@HLQ@.MIG.SRC.SORTED,DISP=SHR
//TGTIN    DD DSN=@HLQ@.MIG.TGT.UNLOAD,DISP=SHR
//DEDUP    DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//EXCOUT   DD DSN=@HLQ@.MIG.RECON.EXCEPT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=3100)
//CTLOUT   DD DSN=@HLQ@.MIG.CTRL.OUT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=150,BLKSIZE=1500)
//*------------------ ASSIGNMENT 3 : REXX ---------------------------
//REXXRUN  EXEC RXBATCH,EXEC=MIGREXX,SLIB='@HLQ@.MIG.REXX'
//EXEC.SRCRAW  DD DSN=@HLQ@.MIG.SRC.EXTRACT,DISP=SHR
//EXEC.TGTRAW  DD DSN=@HLQ@.MIG.TGT.EXTRACT,DISP=SHR
//EXEC.CTLIN   DD DSN=@HLQ@.MIG.CTRL.OUT,DISP=SHR
//EXEC.EXCIN   DD DSN=@HLQ@.MIG.RECON.EXCEPT,DISP=SHR
//EXEC.EXCSORT DD DSN=@HLQ@.MIG.RECON.EXCSORT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=3100)
//EXEC.REPORT  DD DSN=@HLQ@.MIG.RECON.REPORT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=3325)
//EXEC.MIGOUT  DD DSN=@HLQ@.MIG.RECON.MIGOUT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=133,BLKSIZE=3325)
//EXEC.AUDREC  DD DSN=@HLQ@.MIG.RECON.AUDREC,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=1200)
//EXEC.EXCREC  DD DSN=@HLQ@.MIG.RECON.EXCREC,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=3000)
//*------------------ VSAM audit log (skipped if REXX failed) -------
//AUDIT    EXEC PGM=IDCAMS,COND=(16,LE,REXXRUN.EXEC)
//SYSPRINT DD SYSOUT=*
//A        DD DSN=@HLQ@.MIG.RECON.AUDREC,DISP=SHR
//AK       DD DSN=@HLQ@.MIG.AUDIT.KSDS,DISP=OLD
//E        DD DSN=@HLQ@.MIG.RECON.EXCREC,DISP=SHR
//EK       DD DSN=@HLQ@.MIG.EXCLOG.KSDS,DISP=OLD
//SYSIN    DD *
 REPRO INFILE(A) OUTFILE(AK)
 REPRO INFILE(E) OUTFILE(EK)
/*
//*------------------ ASSIGNMENT 4 : JCL GATE (COND codes) ----------
//*  APPROVE runs when REXXRUN RC <= 4, REJECT when RC > 4
//APPROVE  EXEC PGM=IEBGENER,COND=(4,LT,REXXRUN.EXEC)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=SHR
//SYSUT2   DD DSN=@HLQ@.MIG.GATE.APPROVED(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,15),RLSE),
//            DCB=(@HLQ@.MIG.GDGMODEL,RECFM=FB,LRECL=80,BLKSIZE=3120)
//REJECT   EXEC PGM=IEBGENER,COND=(4,GE,REXXRUN.EXEC)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@HLQ@.MIG.RECON.EXCSORT,DISP=SHR
//SYSUT2   DD DSN=@HLQ@.MIG.GATE.REJECTED(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(@HLQ@.MIG.GDGMODEL,RECFM=FB,LRECL=100,BLKSIZE=3100)
//*------------------ print the results (always) --------------------
//PRINTRPT EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@HLQ@.MIG.RECON.REPORT,DISP=SHR
//SYSUT2   DD SYSOUT=*
//PRINTOUT EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD DUMMY
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@HLQ@.MIG.RECON.MIGOUT,DISP=SHR
//SYSUT2   DD SYSOUT=*
//
